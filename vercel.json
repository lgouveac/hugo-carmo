{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/post.js": { "includeFiles": "post.html" }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.hugocarmo.com.br" }],
      "destination": "https://hugocarmo.com.br/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/llms.txt", "destination": "/api/llms" },
    { "source": "/blog/:slug", "destination": "/api/post?slug=:slug" },
    { "source": "/en/blog/:slug", "destination": "/api/post?slug=:slug&lang=en" },
    { "source": "/en/blog", "destination": "/blog" },
    { "source": "/viagem/:slug", "destination": "/viagem" },
    { "source": "/en/viagem/:slug", "destination": "/viagem" },
    { "source": "/en/loja", "destination": "/loja" },
    { "source": "/en/temas", "destination": "/temas" },
    { "source": "/en/provador", "destination": "/provador" },
    { "source": "/en/cicloviagens", "destination": "/cicloviagens" },
    { "source": "/en/fotolivros", "destination": "/fotolivros" },
    { "source": "/en/sobre", "destination": "/sobre" },
    { "source": "/en/faq", "destination": "/faq" },
    { "source": "/en", "destination": "/" }
  ]
}
