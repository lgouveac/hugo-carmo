{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/post.js": { "includeFiles": "post.html" }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.hugocarmo.com.br" }],
      "destination": "https://hugocarmo.com.br/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/llms.txt", "destination": "/api/llms" },
    { "source": "/blog/:slug", "destination": "/api/post?slug=:slug" },
    { "source": "/en/blog/:slug", "destination": "/api/post?slug=:slug&lang=en" },
    { "source": "/en/blog", "destination": "/blog.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/viagem/:slug", "destination": "/viagem.html" },
    { "source": "/en/viagem/:slug", "destination": "/viagem.html" },
    { "source": "/viagem", "destination": "/viagem.html" },
    { "source": "/en/loja", "destination": "/loja.html" },
    { "source": "/loja", "destination": "/loja.html" },
    { "source": "/en/temas", "destination": "/temas.html" },
    { "source": "/temas", "destination": "/temas.html" },
    { "source": "/en/provador", "destination": "/provador.html" },
    { "source": "/provador", "destination": "/provador.html" },
    { "source": "/en/cicloviagens", "destination": "/cicloviagens.html" },
    { "source": "/cicloviagens", "destination": "/cicloviagens.html" },
    { "source": "/en/fotolivros", "destination": "/fotolivros.html" },
    { "source": "/fotolivros", "destination": "/fotolivros.html" },
    { "source": "/en/sobre", "destination": "/sobre.html" },
    { "source": "/sobre", "destination": "/sobre.html" },
    { "source": "/en/faq", "destination": "/faq.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/en", "destination": "/index.html" }
  ]
}
